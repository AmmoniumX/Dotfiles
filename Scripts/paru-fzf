#!/usr/bin/env bash
# Fuzzy package search and install (original based on: https://github.com/basecamp/omarchy/blob/ddef52c192f502c6dff7a02860c46d295eba0d93/bin/omarchy-pkg-install)

## USAGE:
##  paru-fzf [OPTIONS...]
##
## OPTIONS:
##  --repo: Only search in the official repositories (default: false)
##  --no-sync: Do not sync the package database before searching (default: false)
##  --no-update: Do not update the system before installing packages (default: false)

REPO_ONLY=false
NO_SYNC=false
NO_UPDATE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      REPO_ONLY=true
      shift
      ;;
    --no-sync)
      NO_SYNC=true
      shift
      ;;
    --no-update)
      NO_UPDATE=true
      shift
      ;;
    -*)
      echo "Error: Unknown option: $1" >&2
      exit 1
      ;;
    *)
      echo "Error: Unexpected argument: $1" >&2
      exit 1
      ;;
  esac
done

repo_list='paru -Slq --repo | sort -u'
all_list='paru -Slq | sort -u'
repo_prompt='r> '
all_prompt='ra> '

if $REPO_ONLY; then
  start_list=$repo_list
  start_prompt=$repo_prompt
else
  start_list=$all_list
  start_prompt=$all_prompt
fi

# alt-a switches between the two lists, using the prompt to tell which one is active
toggle_aur="[ \"\$FZF_PROMPT\" = '$repo_prompt' ] \
  && echo 'change-prompt($all_prompt)+reload($all_list)' \
  || echo 'change-prompt($repo_prompt)+reload($repo_list)'"

fzf_args=(
  --multi
  --with-shell 'bash -c'
  --prompt "$start_prompt"
  --bind "start:reload($start_list)"
  --bind "alt-a:transform:$toggle_aur"
  --preview 'paru -Si {1} | awk "/^Repository/{n++} n>1{exit} 1"'
  --preview-label='alt-a: toggle AUR, alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:50%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

if ! $NO_SYNC; then
  sudo pacman -Sy
fi

pkgs=$(fzf "${fzf_args[@]}" | xargs)

paru_install_pkgs() {
  # Quietly do nothing if no packages were selected
  if [ -n "$pkgs" ]; then
    paru -S $pkgs
  fi
}

if $NO_UPDATE; then
  paru_install_pkgs
else
  paru -Su --repo && paru_install_pkgs && paru -Su --aur --upgrademenu
fi
