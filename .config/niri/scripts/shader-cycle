#!/usr/bin/env bash
# shader-cycle [cursor|screen|close]: point the group's shader include at the next shader in that group.
set -euo pipefail

group="${1:-cursor}"
base="$(dirname "$(realpath "$0")")/../shaders"
base="$(realpath "$base")"
dir="$base/$group"
case "$group" in
  cursor|screen) linkname="current.kdl" ;;
  close)         linkname="current-close.kdl" ;;
  *) echo "shader-cycle: unknown group: $group" >&2; exit 1 ;;
esac
link="$base/$linkname"
state="${XDG_RUNTIME_DIR:-/tmp}/niri-shader-$group.idx"

[ -d "$dir" ] || { echo "shader-cycle: no such group: $dir" >&2; exit 1; }

shaders=("off.kdl")
while IFS= read -r f; do
  shaders+=("${f#"$base"/}")
done < <(find "$dir" -maxdepth 1 -name '*.kdl' | sort)
n=${#shaders[@]}

idx=0
[ -r "$state" ] && read -r idx < "$state" 2>/dev/null || true
case "$idx" in '' | *[!0-9]*) idx=0 ;; esac
idx=$(( (idx + 1) % n ))

target="${shaders[idx]}"
ln -sfn "$target" "$link"
printf '%s\n' "$idx" > "$state"

niri msg action load-config-file >/dev/null 2>&1 || true

name="$(basename "$target")"
command -v notify-send >/dev/null 2>&1 \
  && notify-send -t 1500 "niri $group shader" "${name%.kdl}" || true
