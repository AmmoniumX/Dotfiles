// Fade with expanding ring
// Window opens as a ring sweeps outward from the center revealing it, and closes
// as a ring shrinks back inward toward the center erasing it

animations {

    window-open {
        duration-ms 200
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_clamped_progress;
                vec2 uv = coords_geo.xy;

                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                vec2 center = vec2(0.5, 0.5);
                float dist = distance(uv, center);

                // Ring sweeps outward from the center, revealing the window as it passes
                float ring_radius = progress * 0.85;
                float ring_width = 0.3;
                float revealed = 1.0 - smoothstep(ring_radius - ring_width, ring_radius, dist);

                // Bright edge glow riding along the ring
                float edge = 1.0 - smoothstep(0.0, ring_width, abs(dist - ring_radius));
                vec3 glow = mix(color.rgb, vec3(1.0), edge * 0.3 * progress);

                float fade = revealed * smoothstep(0.0, 0.15, progress);

                return vec4(glow, color.a) * fade;
            }
        "
    }

    window-close {
        duration-ms 300
        curve "linear"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float progress = niri_clamped_progress;
                vec2 uv = coords_geo.xy;

                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                vec2 center = vec2(0.5, 0.5);
                float dist = distance(uv, center);

                // Ring shrinks inward toward the center, erasing the window as it passes
                float ring_radius = mix(0.85, 0.0, progress);
                float ring_width = 0.3;
                float visible = 1.0 - smoothstep(ring_radius - ring_width, ring_radius, dist);

                // Bright edge glow riding just ahead of the erased area
                float edge = 1.0 - smoothstep(0.0, ring_width, abs(dist - ring_radius));
                vec3 glow = mix(color.rgb, vec3(1.0), edge * 0.3 * progress);

                // Overall fade so nothing lingers once fully collapsed
                float fade = visible * (1.0 - smoothstep(0.9, 1.0, progress));

                return vec4(glow, color.a) * fade;
            }
        "
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.8 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.001
    }
}
